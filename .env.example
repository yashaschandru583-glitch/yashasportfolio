# GEMINI_API_KEY: Optional if AI capabilities are used
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# PORT: Server port (defaults to 3000 in this container)
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string.
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
# (If not provided, the backend seamlessly falls back to a high-speed in-memory seeded store)
MONGODB_URI=""

# JWT_SECRET: Secret key for signing admin authentication tokens
JWT_SECRET="portfolio_jwt_super_secret_dev_key_2025"

# ADMIN_EMAIL & ADMIN_PASSWORD: Default initial credentials for Admin CMS login
ADMIN_EMAIL="admin@developer.com"
ADMIN_PASSWORD="admin123password"

